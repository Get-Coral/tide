# Server
HOST=0.0.0.0
PORT=3000

# Where finished downloads land. Tide derives its in-progress directory as a
# sibling of this path, so TIDE_DOWNLOADS_DIR=/downloads/complete puts partial
# files in /downloads/incomplete. Keeping both under one mount means a finished
# torrent is moved with a rename instead of a full file copy.
TIDE_DOWNLOADS_DIR=/downloads/complete
# Legacy alias, still honoured if TIDE_DOWNLOADS_DIR is unset:
# TORRENT_DOWNLOADS_DIR=

# SQLite state (tide.sqlite)
TIDE_DATA_DIR=/data

# HTTP basic auth. Leave both blank to disable it — only do that if Tide is not
# reachable beyond localhost.
TIDE_AUTH_USERNAME=
TIDE_AUTH_PASSWORD=

# Optional Jellyfin sign-in, off by default. Tide uses Jellyfin purely as an
# identity provider: it stores the server URL and no API key. Set the URL here
# or from the Access card on /manage, then turn the requirement on.
# TIDE_JELLYFIN_URL=https://jellyfin.example.com
#
# Forces the sign-in requirement on or off, overriding whatever is stored in
# SQLite. Setting it to false is the way back in if you lock yourself out.
# TIDE_REQUIRE_LOGIN=true

# Memory guard. Tide reads the container memory cap from cgroups when it can;
# these override or force the thresholds. Torrents pause above PAUSE_MB and
# resume below RESUME_MB.
# TIDE_MEMORY_LIMIT_MB=8192
# TIDE_MEMORY_PAUSE_MB=7168
# TIDE_MEMORY_RESUME_MB=6144
# TIDE_MEMORY_CHECK_INTERVAL_MS=5000
